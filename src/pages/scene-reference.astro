---
/**
 * Scène de référence — Una mesa para dos.
 * Page de travail, indépendante de la homepage (non indexée).
 * Paramètres : ?plan=large|place|objets  et  ?fixe (sans dérive ni vacillement, pour les captures).
 */
import '@fontsource-variable/jost';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>LA SALA · Scène de référence</title>
  </head>
  <body>
    <canvas data-toile></canvas>
    <nav class="plans" aria-label="Plans de la scène">
      <button type="button" data-plan="large">Plan large</button>
      <button type="button" data-plan="place">La place vide</button>
      <button type="button" data-plan="objets">Les objets</button>
    </nav>
    <p class="attente" data-attente>La table se prépare…</p>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    height: 100%;
    background: #070506;
    overflow: hidden;
  }
  canvas {
    display: block;
    width: 100vw;
    height: 100svh;
  }
  .plans {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: rgb(8 7 10 / 0.6);
  }
  .plans button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 0;
    background: none;
    color: rgb(241 233 220 / 0.7);
    font: 450 0.6875rem/1 var(--font-generique);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .plans button[aria-pressed='true'] {
    color: var(--marfil);
    box-shadow: inset 0 -1px 0 var(--champan);
  }
  .attente {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: rgb(241 233 220 / 0.5);
    font: italic 400 1rem/1 Georgia, serif;
    pointer-events: none;
  }
</style>

<script>
  import { creerScene, type Plan } from '../scripts/table/scene';

  const params = new URLSearchParams(location.search);
  const plan = (['large', 'place', 'objets'].includes(params.get('plan') ?? '') ? params.get('plan') : 'large') as Plan;
  const toile = document.querySelector<HTMLCanvasElement>('[data-toile]')!;
  const boutons = [...document.querySelectorAll<HTMLButtonElement>('[data-plan]')];
  const marquer = (p: string) => boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.plan === p)));
  marquer(plan);

  creerScene(toile, { plan, fixe: params.has('fixe') }).then(({ allerA }) => {
    document.querySelector('[data-attente]')?.remove();
    (window as unknown as { __sceneOk: boolean }).__sceneOk = true;
    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        allerA(b.dataset.plan as Plan);
        marquer(b.dataset.plan!);
      }),
    );
  });
</script>
