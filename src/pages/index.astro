---
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Scene from '../components/Scene.astro';
import Clarte from '../components/Clarte.astro';
import { site } from '../config/site';
import { etapes, soiree } from '../config/recit';
import { lienInformation } from '../lib/format';

const titre = `${site.marque} · Dîners à l’aveugle · bientôt à ${site.destination.ville}`;
const description =
  'Une table pour deux. Une personne que vous n’avez pas choisie. Dîners à l’aveugle, sans photo ni profil. LA SALA arrive bientôt à Lyon.';
const lien = site.ouverture.lienInformation;
---

<Base titre={titre} description={description}>
  <link slot="tete" rel="preload" as="image" href="/scene/arrivee-p.jpg" media="(orientation: landscape)" />
  <link slot="tete" rel="preload" as="image" href="/scene/arrivee-v.jpg" media="(orientation: portrait)" />

  <Scene />
  <Entete />

  <main id="contenu" class="recit">
    <!-- 1. Arrivée -->
    <section class="moment moment--arrivee" data-plan="arrivee" aria-labelledby="arrivee-titre">
      <div class="texte texte--arrivee">
        <h1 id="arrivee-titre" class="affiche arrivee__titre">
          Une table pour deux.<br />Une personne que vous n’avez pas choisie.
        </h1>
        <p class="arrivee__sous">Dîners à l’aveugle · bientôt à {site.destination.ville}</p>
        <a class="appel" href={lienInformation()}>Être informé de l’ouverture</a>
      </div>
    </section>

    <!-- 2. La question, seule. Du silence avant et après. -->
    <section class="moment moment--question" data-plan="flamme" data-jour="0.45" aria-labelledby="question-titre">
      <h2 id="question-titre" class="affiche question">Et si nous arrêtions de choisir avant de rencontrer&nbsp;?</h2>
    </section>
    <div class="silence" data-plan="flamme" data-jour="0.45" aria-hidden="true"></div>

    <!-- 3. Comment ça se passe -->
    <section class="deroule" aria-labelledby="deroule-titre">
      <h2 id="deroule-titre" class="sr-only">Comment ça se passe</h2>
      {
        etapes.map((e, i) => (
          <article class="moment moment--etape" data-plan={e.plan} data-bougie={e.bougie} data-jour={e.jour}>
            <div class="texte">
              {i === 0 && <p class="etiquette">Comment ça se passe</p>}
              <p class="compte" aria-hidden="true">
                {i + 1} / {etapes.length}
              </p>
              <h3 class="etape__titre">{e.titre}</h3>
              <p class="etape__texte">{e.texte}</p>
            </div>
          </article>
        ))
      }
    </section>

    <!-- 4. La place vide -->
    <section class="moment moment--place" data-plan="place" aria-labelledby="place-titre">
      <div class="texte texte--place">
        <h2 id="place-titre" class="affiche place">Cette place est pour quelqu’un que vous ne connaissez pas encore.</h2>
      </div>
    </section>

    <!-- 5. Une soirée -->
    <section class="soiree" aria-labelledby="soiree-titre">
      <h2 id="soiree-titre" class="sr-only">Une soirée</h2>
      {
        soiree.map((e, i) => (
          <article class="moment moment--soiree" data-plan={e.plan} data-bougie={e.bougie} data-jour={e.jour}>
            <div class="texte">
              {i === 0 && <p class="etiquette">Une soirée</p>}
              <h3 class="etape__titre">{e.titre}</h3>
              <p class="etape__texte">{e.texte}</p>
            </div>
          </article>
        ))
      }
    </section>

    <!-- 6. Ce qu'il faut savoir -->
    <Clarte />

    <!-- 7. Fin -->
    <section id="ouverture" class="moment moment--fin" data-plan="fin" data-bougie="basse" aria-labelledby="fin-titre">
      <div class="texte texte--fin">
        <h2 id="fin-titre" class="affiche fin__titre">
          Vous ne vous êtes pas choisis.<br />Vous êtes simplement venus.
        </h2>
        <p class="fin__annonce">{site.ouverture.annonce}</p>
        {
          lien ? (
            <a class="appel" href={lien}>
              Être informé de l’ouverture
            </a>
          ) : (
            <>
              <p class="appel appel--inactif" aria-disabled="true">
                Être informé de l’ouverture
              </p>
              <p class="fin__note">L’inscription à l’annonce d’ouverture arrive très prochainement, ici même.</p>
            </>
          )
        }
      </div>
    </section>
  </main>

  <footer class="pied">
    <p>
      {site.marque} · {site.destination.mention} : {site.destination.ville}
    </p>
    <p class="pied__doux">{site.destination.prochaines}</p>
    {site.contact.email && <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}
  </footer>

  <script>
    import '../scripts/accueil/realisateur';
  </script>
</Base>

<style>
  .recit {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }

  /* — Un moment = un plan de la table. Le texte est posé dans l'ombre du cadre :
       à gauche en paysage, en haut en portrait. — */
  .moment {
    position: relative;
    min-height: 130svh;
    padding: 0 var(--gouttiere);
  }
  .texte {
    position: sticky;
    top: 30svh;
    max-width: 24rem;
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
    text-shadow: 0 1px 12px rgb(6 5 5 / 0.7);
  }
  @media (orientation: portrait) {
    .texte {
      top: calc(env(safe-area-inset-top) + 5.5rem);
      max-width: 30rem;
    }
  }
  @media (min-width: 64rem) {
    .moment {
      padding-left: calc(var(--gouttiere) + 4vw);
    }
  }

  /* Apparition lente du texte (le texte existe dès le départ, sans JavaScript). */
  :global(html.js) .texte,
  :global(html.js) .question {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 1600ms var(--ease-fondu),
      transform 1600ms var(--ease-sortie);
  }
  :global(html.js) .est-actif .texte,
  :global(html.js) .est-actif .question {
    opacity: 1;
    transform: none;
  }

  .etiquette,
  .compte {
    font-family: var(--font-generique);
    font-size: var(--fs-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champan);
  }
  .compte {
    color: rgb(241 233 220 / 0.55);
    font-variant-numeric: tabular-nums;
  }

  /* 1. Arrivée */
  .moment--arrivee {
    min-height: 100svh;
  }
  .texte--arrivee {
    top: 0;
    min-height: 100svh;
    align-content: center;
    max-width: 30rem;
    gap: var(--sp-5);
  }
  @media (orientation: portrait) {
    .texte--arrivee {
      align-content: start;
      padding-top: calc(env(safe-area-inset-top) + 6.5rem);
    }
  }
  .arrivee__titre {
    font-size: clamp(2rem, 5.4vw, 3.6rem);
    line-height: 1.08;
  }
  .arrivee__sous {
    font-size: var(--fs-lead);
    font-style: italic;
    color: rgb(241 233 220 / 0.82);
  }
  .texte--arrivee .appel {
    justify-self: start;
    margin-top: var(--sp-3);
  }

  /* 2. La question */
  .moment--question {
    min-height: 170svh;
    padding-top: 40svh;
  }
  .question {
    position: sticky;
    top: 34svh;
    max-width: 13ch;
    font-size: clamp(2.1rem, 5.6vw, 4.2rem);
    line-height: 1.08;
    text-shadow: 0 1px 12px rgb(6 5 5 / 0.7);
  }
  @media (orientation: portrait) {
    .question {
      top: 16svh;
    }
  }
  .silence {
    height: 60svh;
  }

  /* 3 et 5. Étapes */
  .etape__titre {
    font-family: var(--font-lettre);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.625rem, 3.6vw, 2.25rem);
    line-height: 1.15;
  }
  .etape__texte {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: rgb(241 233 220 / 0.86);
  }
  .moment--etape,
  .moment--soiree {
    min-height: 115svh;
  }

  /* 4. La place vide */
  .moment--place {
    min-height: 170svh;
  }
  .texte--place {
    max-width: 22rem;
  }
  .place {
    font-size: clamp(1.9rem, 4.6vw, 3.2rem);
    line-height: 1.12;
  }

  /* 7. Fin */
  .moment--fin {
    min-height: 150svh;
  }
  .texte--fin {
    max-width: 28rem;
    gap: var(--sp-5);
  }
  @media (orientation: portrait) {
    .texte--fin {
      gap: var(--sp-3);
      padding-block: var(--sp-4);
    }
  }
  .fin__titre {
    font-size: clamp(1.9rem, 4.8vw, 3.3rem);
    line-height: 1.1;
  }
  .fin__annonce {
    font-size: var(--fs-lead);
    font-style: italic;
  }
  .texte--fin .appel {
    justify-self: start;
  }
  .fin__note {
    max-width: 22rem;
    font-size: var(--fs-petit);
    color: rgb(241 233 220 / 0.7);
  }

  .pied {
    position: relative;
    z-index: 2;
    background: #060505;
    color: rgb(241 233 220 / 0.75);
    padding: var(--sp-8) var(--gouttiere) calc(var(--sp-8) + env(safe-area-inset-bottom));
    font-family: var(--font-generique);
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: grid;
    gap: var(--sp-2);
  }
  .pied__doux {
    color: rgb(241 233 220 / 0.45);
  }
  :global(html.capture) .recit,
  :global(html.capture) .pied {
    visibility: hidden;
  }
</style>
