---
import { lienInformation } from '../lib/format';
---

<nav class="barre" aria-label="Navigation mobile">
  <button class="barre__item generique" type="button" data-ouvrir-carte aria-haspopup="dialog">
    Carte de bal
  </button>
  <a class="barre__item barre__item--action generique" href={lienInformation()}>
    Être informé
  </a>
</nav>

<style>
  .barre {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    padding-bottom: env(safe-area-inset-bottom);
    background: rgb(22 5 9 / 0.92);
    border-top: 1px solid rgb(216 195 155 / 0.18);
    backdrop-filter: blur(6px);
    transition:
      transform 900ms var(--ease-sortie),
      visibility 0s linear 0s;
  }
  /* Après la question fondatrice : un silence, aucun appel à la réservation. */
  :global(html[data-scene='question']) .barre {
    transform: translateY(110%);
    visibility: hidden;
    transition:
      transform 900ms var(--ease-sortie),
      visibility 0s linear 900ms;
  }
  .barre__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    padding-inline: var(--sp-3);
    color: var(--marfil);
    letter-spacing: 0.14em;
    text-decoration: none;
    text-align: center;
  }
  .barre__item--action {
    color: var(--champan);
    border-left: 1px solid rgb(216 195 155 / 0.18);
  }
  @media (min-width: 48rem) {
    .barre {
      display: none;
    }
  }
</style>
