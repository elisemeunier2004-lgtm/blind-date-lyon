---
import type { Seance } from '../config/site';
import { heure, jourLong } from '../lib/format';

interface Props {
  seance: Seance;
}
const { seance } = Astro.props;
---

<div class="billet papier" data-billet>
  <div class="billet__corps">
    <p class="generique billet__numero">Séance Nº {seance.numero}</p>
    <p class="billet__date affiche">{jourLong(seance.date)}</p>
    <p class="generique">{heure(seance.date)} · {seance.quartier}</p>
    <dl class="billet__places">
      <div>
        <dt class="generique">Votre place</dt>
        <dd class="affiche">G · 17</dd>
      </div>
      <div class="billet__voisine">
        <dt class="generique">Place 18</dt>
        <dd class="affiche"><em>réservée</em></dd>
      </div>
    </dl>
  </div>

  <button class="billet__talon" type="button" data-billet-talon>
    <span class="billet__talon-texte generique">Déchirer<br />pour entrer</span>
    <span class="sr-only">Déchirer le billet et entrer dans la salle</span>
  </button>
</div>

<style>
  .billet {
    --encoche: 0.6rem;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    width: min(100%, 25rem);
    background: var(--marfil);
    color: var(--noche);
    filter: drop-shadow(0 1.5rem 2.5rem rgb(0 0 0 / 0.55));
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .billet__corps {
    padding: var(--sp-5) var(--sp-5) var(--sp-4);
    display: grid;
    gap: var(--sp-1);
  }
  .billet__numero {
    color: var(--burdeos);
  }
  .billet__date {
    font-size: 1.625rem;
    font-style: italic;
    line-height: 1.1;
    text-transform: lowercase;
  }
  .billet__places {
    display: flex;
    gap: var(--sp-6);
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--filet);
  }
  .billet__places dd {
    margin: 0;
    font-size: 1.375rem;
  }
  .billet__voisine dd {
    color: var(--burdeos);
  }

  .billet__talon {
    position: relative;
    display: grid;
    place-items: center;
    width: 5.25rem;
    min-height: 100%;
    padding: var(--sp-3);
    background: var(--marfil);
    color: var(--burdeos);
    border-left: 2px dashed rgb(91 17 30 / 0.45);
    transition:
      transform 900ms var(--ease-sortie),
      opacity 900ms var(--ease-sortie);
    touch-action: pan-y;
  }
  .billet__talon::before,
  .billet__talon::after {
    content: '';
    position: absolute;
    left: calc(var(--encoche) * -1 - 1px);
    width: calc(var(--encoche) * 2);
    height: calc(var(--encoche) * 2);
    border-radius: 50%;
    background: var(--noche);
  }
  .billet__talon::before {
    top: calc(var(--encoche) * -1);
  }
  .billet__talon::after {
    bottom: calc(var(--encoche) * -1);
  }
  .billet__talon-texte {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.6875rem;
    text-align: center;
  }
  .billet__talon:hover .billet__talon-texte {
    text-decoration: underline;
  }

  .billet.est-dechire .billet__talon {
    transform: translate(2.5rem, 1.5rem) rotate(14deg);
    opacity: 0;
    pointer-events: none;
  }
</style>
