---
import { site } from '../config/site';
import { chapitres } from '../config/nuit';
---

<dialog class="carte papier" data-carte aria-labelledby="carte-titre">
  <div class="carte__entete">
    <p id="carte-titre" class="generique">Carte de bal · {site.marque}</p>
    <button class="carte__fermer generique" type="button" data-fermer-carte>Fermer</button>
  </div>

  <p class="carte__destination generique">{site.destination.mention} : {site.destination.ville}</p>

  <nav aria-label="La nuit">
    <ol class="carte__nuit">
      <li><a href="#entree"><span class="carte__h affiche">20:47</span> L’invitation</a></li>
      <li><a href="#question"><span class="carte__h affiche">20:55</span> La question</a></li>
      {
        chapitres.map((c) => (
          <li>
            <a href={`#${c.id}`}>
              <span class="carte__h affiche">{c.heure}</span> {c.titre}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <nav aria-label="Informations">
    <ul class="carte__infos">
      <li><a href="#seances">Les séances <small>dates, lieux, prix</small></a></li>
      <li><a href="#engagement">L’engagement <small>secret, sécurité, garanties</small></a></li>
      <li><a href="#questions">Questions <small>qui, comment, conditions</small></a></li>
      <li><a href="#cartas">Cartas <small>les épisodes vidéo</small></a></li>
    </ul>
  </nav>
</dialog>

<style>
  .carte {
    width: min(100vw, 30rem);
    max-width: 100vw;
    max-height: 100svh;
    margin: auto 0 0 auto;
    padding: var(--sp-6) var(--gouttiere) calc(var(--sp-7) + env(safe-area-inset-bottom));
    background: var(--fond);
    color: var(--texte);
    border: 0;
    overflow-y: auto;
  }
  .carte::backdrop {
    background: rgb(8 7 10 / 0.7);
  }
  .carte[open] {
    animation: carte-entree 600ms var(--ease-sortie);
  }
  @keyframes carte-entree {
    from { transform: translateY(8%); opacity: 0; }
  }
  @media (min-width: 48rem) {
    .carte {
      height: 100svh;
      margin: 0 0 0 auto;
    }
    .carte[open] {
      animation-name: carte-entree-cote;
    }
    @keyframes carte-entree-cote {
      from { transform: translateX(8%); opacity: 0; }
    }
  }
  .carte__entete {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--filet);
  }
  .carte__fermer {
    min-height: 2.75rem;
    padding-inline: var(--sp-2);
  }
  .carte__destination {
    margin-block: var(--sp-5) var(--sp-4);
    color: var(--texte-doux);
  }
  .carte ol,
  .carte ul {
    list-style: none;
    padding: 0;
  }
  .carte__nuit li,
  .carte__infos li {
    border-bottom: 1px solid var(--filet);
  }
  .carte__nuit a,
  .carte__infos a {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    min-height: 3rem;
    padding-block: var(--sp-3);
    text-decoration: none;
    font-size: 1.0625rem;
  }
  .carte__h {
    min-width: 3.5rem;
    font-style: italic;
    font-size: 1.25rem;
    color: var(--accent);
    font-variant-numeric: oldstyle-nums;
  }
  .carte__infos {
    margin-top: var(--sp-6);
  }
  .carte__infos a {
    flex-direction: column;
    gap: 0;
  }
  .carte__infos small {
    font-family: var(--font-generique);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texte-doux);
  }
  .carte a:hover {
    color: var(--accent);
  }
</style>

<script>
  const carte = document.querySelector<HTMLDialogElement>('[data-carte]');
  if (carte) {
    document.querySelectorAll('[data-ouvrir-carte]').forEach((b) =>
      b.addEventListener('click', () => carte.showModal()),
    );
    carte.querySelector('[data-fermer-carte]')?.addEventListener('click', () => carte.close());
    carte.addEventListener('click', (e) => {
      // Clic sur le fond (hors du panneau) ou sur un lien : on referme.
      const r = carte.getBoundingClientRect();
      const dehors =
        e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      if ((e.target === carte && dehors) || (e.target as HTMLElement).closest('a')) carte.close();
    });
  }
</script>
