---
import { site } from '../config/site';
import { lienInformation } from '../lib/format';
---

<header class="entete">
  <a class="entete__marque" href="#contenu">{site.marque}</a>
  <a class="entete__lien" href={lienInformation()}>
    <span class="entete__long">Être informé de l’ouverture</span>
    <span class="entete__court" aria-hidden="true">Être informé</span>
  </a>
</header>

<style>
  .entete {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
    padding: max(var(--sp-4), env(safe-area-inset-top)) var(--gouttiere) var(--sp-4);
    color: var(--marfil);
    font-family: var(--font-generique);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition:
      color 600ms var(--ease-sortie),
      background-color 600ms var(--ease-sortie);
  }
  :global(html[data-ambiance='papier']) .entete {
    color: var(--noche);
    background: var(--marfil);
  }
  .entete a {
    text-decoration: none;
    padding-block: var(--sp-3);
  }
  .entete__marque {
    font-weight: 500;
    letter-spacing: 0.34em;
  }
  .entete__lien {
    border-bottom: 1px solid currentColor;
    padding-block: var(--sp-2) !important;
  }
  .entete__court {
    display: none;
  }
  .entete__lien {
    transition: opacity 900ms var(--ease-sortie);
  }
  /* Pendant la question : du silence, aucun appel à l'action. */
  :global(html[data-plan='flamme']) .entete__lien {
    opacity: 0;
    visibility: hidden;
  }
  @media (max-width: 40rem) {
    .entete__long {
      display: none;
    }
    .entete__court {
      display: inline;
    }
  }
  :global(html.capture) .entete {
    display: none;
  }
</style>
