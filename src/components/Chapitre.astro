---
import type { Chapitre } from '../config/nuit';

interface Props {
  chapitre: Chapitre;
}
const { chapitre: c } = Astro.props;
const estRencontre = c.id === 'rencontre';
---

<section
  id={c.id}
  class="chapitre"
  aria-labelledby={`${c.id}-titre`}
  data-scene={c.id}
  data-heure={c.heure}
  data-heure-es={c.heureEs}
  data-tonalite={c.tonalite}
  data-strapontin={c.voisin.strapontin}
  data-cle={c.voisin.cle ? '1' : '0'}
  data-rose={c.voisin.rose ? '1' : '0'}
>
  <div class="chapitre__texte">
    <p class="chapitre__heure generique">
      <span class="affiche">{c.heure}</span>
      <span lang="es">{c.heureEs}</span>
    </p>
    <h2 id={`${c.id}-titre`} class="chapitre__titre generique">{c.titre}</h2>
    <p class="chapitre__phrase affiche">{c.phrase}</p>
    <p class="chapitre__concret">
      <span class="generique">Concrètement</span>
      {c.concretement}
    </p>
  </div>
</section>

{
  estRencontre && (
    <section
      class="chapitre chapitre--place"
      aria-label="La place voisine"
      data-scene="place"
      data-heure={c.heure}
      data-heure-es={c.heureEs}
      data-tonalite="chaude"
      data-regard="voisin"
      data-strapontin="releve"
      data-cle="1"
      data-rose="0"
    >
      <div class="chapitre__texte chapitre__texte--place">
        <p class="chapitre__phrase affiche">
          Cette place est <em>réservée.</em>
        </p>
        <p class="chapitre__phrase chapitre__phrase--suite affiche">Vous venez rencontrer quelqu’un.</p>
      </div>
    </section>
  )
}

<style>
  .chapitre {
    position: relative;
    min-height: 150svh;
    display: flex;
    align-items: flex-end;
    padding: 55svh var(--gouttiere) 18svh;
  }
  .chapitre__texte {
    position: relative;
    width: 100%;
    max-width: var(--mesure);
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-6) 0 var(--sp-5);
  }
  /* Voile de lisibilité : du noir sous le texte, comme des sous-titres. */
  .chapitre__texte::before {
    content: '';
    position: absolute;
    inset: -30% calc(var(--gouttiere) * -1) -40%;
    z-index: -1;
    background: radial-gradient(90% 70% at 30% 60%, rgb(8 7 10 / 0.88), rgb(8 7 10 / 0.6) 55%, transparent 80%);
    pointer-events: none;
  }
  .chapitre__heure {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    color: var(--champan);
  }
  .chapitre__heure .affiche {
    font-size: 1.5rem;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    font-variant-numeric: oldstyle-nums;
  }
  .chapitre__titre {
    color: var(--texte-doux);
  }
  .chapitre__phrase {
    font-size: var(--fs-titre);
    color: var(--marfil);
  }
  .chapitre__concret {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-corps);
    line-height: 1.6;
    color: rgb(241 233 220 / 0.86);
    padding-left: var(--sp-4);
    border-left: 1px solid rgb(216 195 155 / 0.4);
  }
  .chapitre__concret .generique {
    color: var(--champan);
  }

  .chapitre--place {
    min-height: 170svh;
    align-items: center;
    justify-content: center;
    padding-block: 60svh 30svh;
  }
  .chapitre__texte--place {
    text-align: center;
    justify-items: center;
    gap: var(--sp-8);
    max-width: 40rem;
  }
  .chapitre__texte--place::before {
    background: radial-gradient(60% 60% at 50% 50%, rgb(8 7 10 / 0.8), transparent 75%);
  }
  .chapitre__texte--place em {
    color: var(--champan);
  }
  .chapitre__phrase--suite {
    font-size: var(--fs-sous-titre);
    font-style: italic;
  }

  @media (min-width: 64rem) {
    .chapitre {
      padding-left: calc(var(--gouttiere) + 4vw);
      padding-bottom: 14svh;
    }
  }
</style>
